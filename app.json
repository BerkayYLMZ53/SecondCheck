{
  "expo": {
    "name": "SecondCheck",
    "slug": "secondcheck",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "android": { "softwareKeyboardLayoutMode": "resize" },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "SecondCheck, 3 saniyelik yerinde mikrofon testi için mikrofonunuza erişir.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ]
  }
}
