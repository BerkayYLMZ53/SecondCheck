{
  "expo": {
    "name": "SecondCheck",
    "slug": "secondcheck",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "display": "standalone",
      "backgroundColor": "#0b0f19",
      "themeColor": "#0b0f19",
      "shortName": "SecondCheck",
      "description": "İkinci el donanım ekspertiz ve değerleme platformu",
      "preferRelatedApplications": false,
      "icons": [
        {
          "src": "./assets/icon.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "SecondCheck, 3 saniyelik yerinde mikrofon testi için mikrofonunuza erişir.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "SecondCheck ekspertiz kartlarını galerinize kaydetmenize izin verin.",
          "granularPermissions": [
            "photo"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
