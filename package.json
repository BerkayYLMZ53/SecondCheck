{
  "name": "secondcheck",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:listing-parser": "node --test tests/listingParser.test.cjs tests/deviceListingParser.test.cjs tests/parseListingApi.test.cjs tests/listingInput.test.cjs",
    "test:catalog": "node --test tests/catalog.test.cjs",
    "test:listing-analysis": "node --test tests/listingAnalysisReport.test.cjs",
    "test:trust-share": "node --test tests/trustAndShare.test.cjs",
    "test:saved-listings": "node --test tests/savedListings.test.cjs",
    "test:inspection": "node --test tests/inspectionModules.test.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-audio": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-media-library": "~58.0.13",
    "expo-print": "~58.0.8",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.66.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "typescript": "~6.0.3"
  }
}
