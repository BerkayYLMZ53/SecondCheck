{
  "expo": {
    "name": "SecondCheck",
    "slug": "secondcheck",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "display": "standalone",
      "backgroundColor": "#0b0f19",
      "themeColor": "#0b0f19",
      "shortName": "SecondCheck",
      "description": "İkinci el donanım ekspertiz ve değerleme platformu",
      "preferRelatedApplications": false,
      "icons": [
        {
          "src": "./assets/icon.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    "android": {
      "package": "com.secondcheck.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0f19"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "SecondCheck, 3 saniyelik yerinde mikrofon testi için mikrofonunuza erişir.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "SecondCheck ekspertiz kartlarını galerinize kaydetmenize izin verin.",
          "granularPermissions": [
            "photo"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SecondCheck, şasi ve kasa incelemesinde fotoğraf çekmek için kameranıza erişir.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false,
          "microphonePermission": "SecondCheck, 3 saniyelik yerinde mikrofon testi için mikrofonunuza erişir."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SecondCheck, kasa incelemesine yalnızca seçtiğiniz fotoğrafı ekler.",
          "cameraPermission": "SecondCheck, şasi ve kasa incelemesinde fotoğraf çekmek için kameranıza erişir.",
          "microphonePermission": "SecondCheck, 3 saniyelik yerinde mikrofon testi için mikrofonunuza erişir."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "024b1764-6370-4d9b-8b8a-35a980f78101"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/024b1764-6370-4d9b-8b8a-35a980f78101"
    },
    "ios": {}
  }
}
