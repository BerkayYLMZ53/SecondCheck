{
  "expo": {
    "name": "SecondCheck",
    "slug": "secondcheck",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "display": "standalone",
      "backgroundColor": "#0b0f19",
      "themeColor": "#2563eb",
      "shortName": "SecondCheck",
      "description": "İkinci el donanım ekspertiz ve değerleme platformu",
      "preferRelatedApplications": false
    },
    "android": { "softwareKeyboardLayoutMode": "resize" },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "SecondCheck, 3 saniyelik yerinde mikrofon testi için mikrofonunuza erişir.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ]
  }
}
